<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard | NovaRise Academy</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f6fb;
    color:#202040;
}

.admin-header{
    background:linear-gradient(135deg,#171d43,#5b3df5,#8b5cf6);
    color:white;
    padding:25px;
}

.header-inner{
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
}

.admin-header h1{
    margin:0 0 6px;
    font-size:26px;
}

.admin-header p{
    margin:0;
    opacity:.9;
    font-size:13px;
}

.admin-badge{
    background:rgba(255,255,255,.15);
    padding:10px 14px;
    border-radius:12px;
    font-size:12px;
}

.admin-container{
    max-width:1200px;
    margin:25px auto;
    padding:0 18px 45px;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
}

.stat-card{
    background:white;
    padding:22px;
    border-radius:20px;
    border:1px solid #e8e8ef;
    box-shadow:0 7px 22px rgba(0,0,0,.06);
}

.stat-icon{
    font-size:26px;
    margin-bottom:12px;
}

.stat-label{
    color:#777;
    font-size:13px;
}

.stat-value{
    font-size:26px;
    font-weight:800;
    margin-top:7px;
}

.admin-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:22px;
}

.admin-card{
    background:white;
    border-radius:20px;
    padding:22px;
    border:1px solid #e8e8ef;
    box-shadow:0 7px 22px rgba(0,0,0,.06);
}

.admin-card h2{
    margin:0 0 18px;
    font-size:19px;
}

.activity{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:14px 0;
    border-bottom:1px solid #eee;
    gap:10px;
}

.activity:last-child{
    border-bottom:0;
}

.activity-title{
    font-size:13px;
    font-weight:700;
}

.activity-sub{
    color:#888;
    font-size:11px;
    margin-top:4px;
}

.status{
    padding:6px 10px;
    border-radius:20px;
    font-size:10px;
    font-weight:bold;
    white-space:nowrap;
}

.status-success{
    background:#e9f9ef;
    color:#16843b;
}

.status-pending{
    background:#fff7df;
    color:#936d00;
}

.status-inactive{
    background:#ffecec;
    color:#c53030;
}

.table-wrap{
    overflow-x:auto;
}

.admin-table{
    width:100%;
    border-collapse:collapse;
}

.admin-table th,
.admin-table td{
    padding:14px 10px;
    text-align:left;
    border-bottom:1px solid #eee;
    white-space:nowrap;
    font-size:13px;
}

.admin-table th{
    color:#777;
    font-size:12px;
}

.quick-actions{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.action-btn{
    border:0;
    padding:14px 10px;
    border-radius:13px;
    background:#f1efff;
    color:#5138c7;
    font-weight:700;
    cursor:pointer;
}

.action-btn:hover{
    background:#e7e2ff;
}

.admin-note{
    margin-top:22px;
    padding:16px;
    border-radius:14px;
    background:#fff8e7;
    color:#806000;
    font-size:12px;
    line-height:1.5;
}

@media(max-width:900px){
    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .admin-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:550px){
    .stats-grid{
        grid-template-columns:1fr;
    }

    .header-inner{
        align-items:flex-start;
        flex-direction:column;
    }

    .quick-actions{
        grid-template-columns:1fr;
    }

    .admin-header h1{
        font-size:22px;
    }
}
</style>
</head>

<body>

<header class="admin-header">
    <div class="header-inner">
        <div>
            <h1>🛡️ NovaRise Academy</h1>
            <p>Administrator Control Center</p>
        </div>

        <div class="admin-badge">
            🔐 ADMIN PANEL
        </div>
    </div>
</header>


<main class="admin-container">

    <!-- STATISTICS -->

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-label">Total Members</div>
            <div class="stat-value" id="totalMembers">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💳</div>
            <div class="stat-label">Total Payments</div>
            <div class="stat-value">₹0</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💰</div>
            <div class="stat-label">Total Income</div>
            <div class="stat-value">₹0</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📤</div>
            <div class="stat-label">Pending Withdrawals</div>
            <div class="stat-value">0</div>
        </div>

    </div>


    <div class="admin-grid">

        <!-- QUICK ACTIONS -->

        <div class="admin-card">

            <h2>⚡ Quick Actions</h2>

            <div class="quick-actions">

                <button class="action-btn"
                    onclick="showAdminMessage('Members')">
                    👥 Members
                </button>

                <button class="action-btn"
                    onclick="showAdminMessage('Payments')">
                    💳 Payments
                </button>

                <button class="action-btn"
                    onclick="showAdminMessage('Withdrawals')">
                    📤 Withdrawals
                </button>

                <button class="action-btn"
                    onclick="showAdminMessage('Support')">
                    💬 Support
                </button>

                <button class="action-btn"
                    onclick="showAdminMessage('Notifications')">
                    🔔 Notifications
                </button>

                <button class="action-btn"
                    onclick="showAdminMessage('Reports')">
                    📊 Reports
                </button>

            </div>

        </div>


        <!-- SYSTEM STATUS -->

        <div class="admin-card">

            <h2>🟢 System Status</h2>

            <div class="activity">
                <div>
                    <div class="activity-title">
                        Member Portal
                    </div>
                    <div class="activity-sub">
                        Frontend
                    </div>
                </div>

                <span class="status status-success">
                    ACTIVE
                </span>
            </div>

            <div class="activity">
                <div>
                    <div class="activity-title">
                        Payment Gateway
                    </div>
                    <div class="activity-sub">
                        Backend integration
                    </div>
                </div>

                <span class="status status-pending">
                    PENDING
                </span>
            </div>

            <div class="activity">
                <div>
                    <div class="activity-title">
                        Database
                    </div>
                    <div class="activity-sub">
                        Secure backend
                    </div>
                </div>

                <span class="status status-pending">
                    PENDING
                </span>
            </div>

        </div>

    </div>


    <!-- RECENT MEMBERS -->

    <div class="admin-card" style="margin-top:22px;">

        <h2>👥 Recent Members</h2>

        <div class="table-wrap">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Member ID</th>
                        <th>Status</th>
                        <th>Membership</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>No members yet</td>
                        <td>
                            <span class="status status-pending">
                                WAITING
                            </span>
                        </td>
                        <td>—</td>
                        <td>—</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <!-- RECENT TRANSACTIONS -->

    <div class="admin-card" style="margin-top:22px;">

        <h2>💳 Recent Transactions</h2>

        <div class="table-wrap">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Member</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>No transactions yet</td>
                        <td>—</td>
                        <td>₹0</td>
                        <td>
                            <span class="status status-pending">
                                WAITING
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>


    <div class="admin-note">
        🔐 <strong>Security:</strong>
        This dashboard is currently a frontend prototype.
        Do not use it as a real administrator system yet.
        Real admin authentication, database access, payment verification
        and withdrawal approval must be implemented on a secure backend.
    </div>

</main>


<script>
function showAdminMessage(section){

    alert(
        section +
        " management will be connected to the secure admin backend."
    );

}
</script>

</body>
</html>
